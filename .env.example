# ── SOPIR — Environment Variables ─────────────────────────────
# Copie este arquivo para .env e ajuste os valores conforme necessário.

# ── Wazuh Indexer (recomendado) ───────────────────────────────
# Preencha com os dados reais do seu Wazuh Indexer/OpenSearch
WAZUH_INDEXER_URL=https://wazuh-indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=mude_para_sua_senha
WAZUH_INDEX_PATTERN=wazuh-alerts-4.x-*
WAZUH_TENANT=vetra
WAZUH_POLL_SECONDS=20

# ── Comportamento ─────────────────────────────────────────────
# false = desativa simulador, usa apenas connectors reais
SOPIR_SIMULATE=false
SOPIR_AUTO_ALERT=true

# ── Autenticação ──────────────────────────────────────────────
JWT_SECRET=troque-esta-chave-secreta-em-producao
FRONTEND_URL=http://localhost:8080
SOPIR_RESET_DEV=true
