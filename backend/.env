# ── SOPIR API ─────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgres://sopir:sopir@sopir-db:5432/sopir

# ── Autenticação JWT + MFA + SSO + Sessões ───────────────────
JWT_SECRET=troque-esta-chave-secreta-em-producao
FRONTEND_URL=http://localhost:8080
SOPIR_RESET_DEV=true

# ── Connector: Wazuh Indexer/OpenSearch ──────────────────────
# Preencha com os dados reais do seu Wazuh Indexer
# Deixe vazio se ainda não tiver o Wazuh configurado
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=
WAZUH_INDEX_PATTERN=wazuh-alerts-4.x-*
WAZUH_TENANT=vetra
WAZUH_POLL_SECONDS=20

# ── Comportamento ─────────────────────────────────────────────
# false = desativa simulador, usa apenas connectors reais
SOPIR_SIMULATE=false
SOPIR_AUTO_ALERT=true
