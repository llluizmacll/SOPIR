# ── SOPIR API ─────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgres://sopir:sopir@sopir-db:5432/sopir

# ── Autenticação JWT + MFA + SSO + Sessões ───────────────────
# Troque esta chave em produção.
JWT_SECRET=troque-esta-chave-secreta-em-producao
# URL pública do frontend (usada nos redirects do SSO/OIDC)
FRONTEND_URL=http://localhost:8080
# true = token de recuperação de senha retorna na resposta (dev/demo).
# Em produção com SMTP, desative e envie o link por e-mail.
SOPIR_RESET_DEV=true
# A validade da sessão (JWT) vem da política em Administration → Identidade
# (security_settings.session_ttl_hours, padrão 12h).

# ── Connector: Wazuh (modo recomendado — Wazuh Indexer/OpenSearch) ──
WAZUH_INDEXER_URL=https://wazuh-indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=
WAZUH_INDEX_PATTERN=wazuh-alerts-4.x-*
# Pular verificação de certificado SSL (útil para certificados auto-assinados)
# Defina como 'true' ou '1' para ignorar validação SSL
WAZUH_SKIP_SSL_VERIFY=false
# Modo alternativo: Wazuh Manager API (4.8+, endpoint /events)
WAZUH_MANAGER_URL=
WAZUH_API_USER=
WAZUH_API_PASS=
# Tenant que recebe os eventos normalizados deste connector
WAZUH_TENANT=vetra
WAZUH_POLL_SECONDS=20

# ── Connector: FortiSIEM (Phoenix REST API) ───────────────────
FORTISIEM_URL=
FORTISIEM_USER=
FORTISIEM_PASS=
FORTISIEM_ORG=
FORTISIEM_TENANT=atlantico
FORTISIEM_POLL_SECONDS=30

# ── Ingest push/webhook (qualquer fonte, ex.: FortiSIEM notify) ──
# POST /api/v1/ingest  com header  X-Api-Key: <chave>
SOPIR_INGEST_KEY=troque-esta-chave

# ── Comportamento ─────────────────────────────────────────────
# auto | true | false — gera eventos sintéticos quando nenhum connector está configurado
# Definido como false para produção; use connectors reais (Wazuh, FortiSIEM, webhooks)
SOPIR_SIMULATE=false
# Cria alertas automaticamente para eventos high/critical (dedup 15min por regra+host)
SOPIR_AUTO_ALERT=true
